Project: FPGA-Based Digital Voltmeter (Auto-scaling)
// Hardware: CD4051 CH1=3.3V, CH0=10V
// Range: sw=0: Auto, sw=1: Manual Force 10V range
// Display Format: XX.YY (Decimal Point: Fixed at AN6)

module XADCdemo(
   input CLK100MHZ,
   input vauxp3,
   input vauxn3,
   input vp_in,
   input vn_in,
   input  sw,             // sw=0: Auto-scaling, sw=1: Manual Force 10V
   output reg [15:0] LED,
   output [7:0] an,
   output dp,
   output pmod,           // Connected to CD4051 Selector A
   output [6:0] seg
);
 
   wire enable, ready;
   wire [15:0] data;      
   reg [63:0] decimal;   
   reg [3:0] dig0, dig1, dig2, dig3, dig4, dig5, dig6, dig7;
   reg [32:0] count;

   // FSM States
   localparam STATE_3V3 = 1'b0;
   localparam STATE_10V = 1'b1;
   reg current_state = STATE_10V; // Safety initial state

   // Hardware logic correction based on your drawing:
   // pmod = 0 selects CH0 (10V range)
   // pmod = 1 selects CH1 (3.3V range)
   assign pmod = (sw == 1'b1) ? 1'b0 : (current_state == STATE_10V ? 1'b0 : 1'b1); 
 
    //xadc instantiation
   xadc_wiz_0  XLXI_7 (.daddr_in(8'h13), 
                     .dclk_in(CLK100MHZ),
                     .den_in(enable),
                     .di_in(0),
                     .dwe_in(0),
                     .busy_out(),                    
                     .vauxp3(vauxp3),
                     .vauxn3(vauxn3),
                     .vn_in(vn_in),
                     .vp_in(vp_in),
                     .alarm_out(),
                     .do_out(data),
                     .reset_in(0),
                     .eoc_out(enable),
                     .channel_out(),
                     .drdy_out(ready));

   // LED Bar Graph
   always @(posedge CLK100MHZ) begin            
      if(ready) begin
         case (data[15:12])
            1:  LED <= 16'b11;
            2:  LED <= 16'b111;
            3:  LED <= 16'b1111;
            4:  LED <= 16'b11111;
            5:  LED <= 16'b111111;
            6:  LED <= 16'b1111111;
            7:  LED <= 16'b11111111;
            8:  LED <= 16'b111111111;
            9:  LED <= 16'b1111111111;
            10: LED <= 16'b11111111111;
            11: LED <= 16'b111111111111;
            12: LED <= 16'b1111111111111;
            13: LED <= 16'b11111111111111;
            14: LED <= 16'b111111111111111;
            15: LED <= 16'b1111111111111111;                        
           default: LED <= 16'b1;
           endcase
      end
   end
 
   // FSM and Scaling Logic
   always @ (posedge CLK100MHZ) begin
      if(count == 10000000) begin 
         decimal = data >> 4; // 12-bit Raw ADC

         // FSM Mode Selection with Hysteresis
         if (sw == 1'b1) begin
            current_state <= STATE_10V; 
         end else begin
            // If in 3.3V mode (pmod=1), check if voltage > 3.1V to switch to 10V
            if(current_state == STATE_3V3 && decimal > 12'd3847) 
               current_state <= STATE_10V;
            // If in 10V mode (pmod=0), check if voltage < 2.8V to switch to 3.3V
            else if(current_state == STATE_10V && decimal < 12'd1158) 
               current_state <= STATE_3V3;
         end
// Scaling based on actual PMOD state
         if(pmod == 1'b1) begin // 3.3V range logic (Hardware CH1)
            if(decimal >= 4093) begin
               dig0=0; dig1=0; dig2=0; dig3=0; dig4=0; dig5=3; dig6=3; dig7=0;
            end else begin
               decimal = (decimal * 825000) >> 10;
               dig0 = decimal % 10; decimal = decimal / 10;
               dig1 = decimal % 10; decimal = decimal / 10;
               dig2 = decimal % 10; decimal = decimal / 10;
               dig3 = decimal % 10; decimal = decimal / 10;
               dig4 = decimal % 10; decimal = decimal / 10; 
               dig5 = decimal % 10; decimal = decimal / 10; 
               dig6 = decimal % 10; decimal = decimal / 10; 
               dig7 = decimal % 10;                         
            end
         end
         
         else begin  // 10V range logic (Hardware CH0)
           if(decimal >= 4093) begin
                dig0 = 0; dig1 = 0; dig2 = 0; dig3 = 0; dig4 = 0; dig5 = 0; dig6 = 0; dig7 = 1;
            end else begin
                decimal = (decimal * 2500000);
                decimal = decimal >> 10;
                dig0 = decimal % 10; decimal = decimal / 10;
                dig1 = decimal % 10; decimal = decimal / 10;
                dig2 = decimal % 10; decimal = decimal / 10;
                dig3 = decimal % 10; decimal = decimal / 10;
                dig4 = decimal % 10; decimal = decimal / 10;
                dig5 = decimal % 10; decimal = decimal / 10;
                dig6 = decimal % 10; decimal = decimal / 10;
                dig7 = decimal % 10;
            end
         end
         count = 0;
      end else begin
         count = count + 1;
      end
   end

   DigitToSeg segment1(.in1(dig0), .in2(dig1), .in3(dig2), .in4(dig3),
                         .in5(dig4), .in6(dig5), .in7(dig6), .in8(dig7),
                         .mclk(CLK100MHZ), .an(an), .dp(dp), .sw(pmod), .seg(seg));  
endmodule

// --- Sub Modules ---

module sevensegdecoder(input [3:0] nIn, output reg [6:0] ssOut);
    always @(nIn)
    case (nIn) 
      4'h0: ssOut = 7'b0000001;
      4'h1: ssOut = 7'b1001111;
      4'h2: ssOut = 7'b0010010;
      4'h3: ssOut = 7'b0000110;
      4'h4: ssOut = 7'b1001100;
      4'h5: ssOut = 7'b0100100;
      4'h6: ssOut = 7'b0100000;
      4'h7: ssOut = 7'b0001111;
      4'h8: ssOut = 7'b0000000;
      4'h9: ssOut = 7'b0000100;
     default: ssOut = 7'b0000001; 
    endcase
endmodule

module segClkDevider(input clk, input rst, output reg clk_div);
    localparam constantNumber = 10000;
    reg [31:0] count;
    always @ (posedge(clk), posedge(rst)) begin
        if (rst == 1'b1) count <= 32'b0;
        else if (count == constantNumber - 1) count <= 32'b0;               
        else count <= count + 1;
    end
    always @ (posedge(clk), posedge(rst)) begin
        if (rst == 1'b1) clk_div <= 1'b0;
        else if (count == constantNumber - 1) clk_div <= ~clk_div;
        else clk_div <= clk_div;
    end
endmodule

module mux4_4bus(input [3:0] I0, I1, I2, I3, I4, I5, I6, I7, input [2:0] Sel, output [3:0] Y);
    assign Y = (Sel == 0)? I0 : (Sel == 1)? I1 : (Sel == 2)? I2 : (Sel == 3)? I3 : 
               (Sel == 4)? I4 : (Sel == 5)? I5 : (Sel == 6)? I6 : I7;
endmodule
 
module decoder_3_8 (input [2:0] I, output [7:0] an, output dp);
    assign an[0] = 1'b1; assign an[1] = 1'b1; assign an[2] = 1'b1; assign an[3] = 1'b1;
    assign an[4] = ~(I[2] & ~I[1] & ~I[0]);
    assign an[5] = ~(I[2] & ~I[1] & I[0]);
    assign an[6] = ~(I[2] & I[1] & ~I[0]);
    assign an[7] = ~(I[2] & I[1] & I[0]);
    assign dp = ~(I[2] & I[1] & ~I[0]); // Fixed DP at AN6
endmodule

module counter3bit (input clk, input rst, output reg [2:0] Q);
    always @ (posedge(clk)) begin
        if (rst == 1'b1) Q <= 3'b0;
        else Q <= Q + 1'b1;
    end
endmodule

module DigitToSeg(input [3:0] in1, in2, in3, in4, in5, in6, in7, in8, input mclk, input sw, output [7:0] an, output [6:0] seg, output dp);
   wire XLXN_94; wire [3:0] XLXN_102; wire [2:0] XLXN_109;
   sevensegdecoder XLXI_6 (.nIn(XLXN_102[3:0]), .ssOut(seg[6:0]));
   mux4_4bus XLXI_45 (.I0(in1), .I1(in2), .I2(in3), .I3(in4), .I4(in5), .I5(in6), .I6(in7), .I7(in8), .Sel(XLXN_109), .Y(XLXN_102));
   segClkDevider XLXI_47 (.clk(mclk), .rst(1'b0), .clk_div(XLXN_94));
   counter3bit XLXI_49 (.clk(XLXN_94), .rst(1'b0), .Q(XLXN_109));
   decoder_3_8 XLXI_50 (.I(XLXN_109), .an(an), .dp(dp));
endmodule
